<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.kmbeast.mapper.BookshelfMapper">

    <insert id="insert" parameterType="cn.kmbeast.pojo.entity.Bookshelf">
        INSERT INTO bookshelf (name, location, capacity, description, create_time)
        VALUES (#{name}, #{location}, #{capacity}, #{description}, #{createTime})
    </insert>

    <update id="update" parameterType="cn.kmbeast.pojo.entity.Bookshelf">
        UPDATE bookshelf
        <set>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="location != null">
                location = #{location},
            </if>
            <if test="capacity != null">
                capacity = #{capacity},
            </if>
            <if test="description != null">
                description = #{description},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="batchDelete" parameterType="list">
        DELETE FROM bookshelf WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="query" resultMap="BaseResultMap">
        SELECT b.*
        FROM bookshelf b
        <where>
            <if test="name != null and name != ''">
                AND b.name LIKE concat('%',#{name},'%')
            </if>
        </where>
        ORDER BY b.id ASC
        <if test="current != null and size != null">
            LIMIT #{offset},#{size}
        </if>
    </select>

    <select id="queryCount" resultType="integer">
        SELECT COUNT(*)
        FROM bookshelf b
        <where>
            <if test="name != null and name != ''">
                AND b.name LIKE concat('%',#{name},'%')
            </if>
        </where>
    </select>

    <select id="getById" resultMap="BaseResultMap">
        SELECT b.* FROM bookshelf b WHERE b.id = #{id}
    </select>

    <select id="queryAll" resultMap="BaseResultMap">
        SELECT b.* FROM bookshelf b ORDER BY b.id ASC
    </select>

    <resultMap id="BaseResultMap" type="cn.kmbeast.pojo.entity.Bookshelf">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="location" property="location"/>
        <result column="capacity" property="capacity"/>
        <result column="description" property="description"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

</mapper>
